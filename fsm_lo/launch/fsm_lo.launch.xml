<launch>
  <let name="pkg_name"  value="fsm_lo"/>
  <arg name="namespace" default="/"/>
  <arg name="node_name" default="fsm_lo"/>
  <arg name="params"    default="$(find-pkg-share fsm_lo)/config/params.yaml"/>
  <!-- ===================================================================== -->
  <node pkg="$(var pkg_name)"
        exec="$(var pkg_name)_interface_node"
        name="$(var node_name)"
        namespace="$(var namespace)"
        output="screen"
  >
    <param from="$(var params)"/>
  </node>
  <!-- ===================================================================== -->
</launch>
