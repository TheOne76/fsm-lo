<launch>
  <!--
    The node is launched with no parameter file at all, so that every parameter
    falls back to its hardcoded default. Three of the corrected defects only
    show themselves on that path.
  -->
  <node name="fsm_lo" pkg="fsm_lo" type="fsm_lo_node" output="screen"/>

  <test test-name="node_defects" pkg="fsm_lo" type="test_node_defects.py"
        time-limit="120.0"/>
</launch>
